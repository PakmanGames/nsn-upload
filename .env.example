# Optional AI assistance for workbooks the deterministic importer cannot read confidently.
# Server-side only; leave empty to run without AI.
OPENROUTER_API_KEY=
# OpenRouter model slug; empty uses anthropic/claude-opus-5.5. The model must support structured_outputs.
OPENROUTER_MODEL=
# "mock" uses the built-in mock interpreter (E2E tests and demos, no network or key needed).
AI_PROVIDER=
